# Copy this file to .env and fill in your Alchemy API keys.
# In Vite, all browser-visible variables must start with VITE_
# Alchemy dashboard: https://dashboard.alchemy.com

# Ethereum Mainnet
# https://eth-mainnet.g.alchemy.com/v2/<YOUR_KEY>
VITE_RPC_ETHEREUM=

# Polygon Mainnet
# https://polygon-mainnet.g.alchemy.com/v2/<YOUR_KEY>
VITE_RPC_POLYGON=

# Arbitrum One
# https://arb-mainnet.g.alchemy.com/v2/<YOUR_KEY>
VITE_RPC_ARBITRUM=

# Base Mainnet
# https://base-mainnet.g.alchemy.com/v2/<YOUR_KEY>
VITE_RPC_BASE=

# Sepolia Testnet
# https://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>
VITE_RPC_SEPOLIA=
